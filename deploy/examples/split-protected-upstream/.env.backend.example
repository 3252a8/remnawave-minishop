IMAGE_TAG=latest
COMPOSE_PROJECT_NAME=remnawave-minishop

WEBHOOK_PUBLIC_URL=https://bot.example.com
MINIAPP_PUBLIC_URL=https://app.example.com/
WEBHOOK_BIND=127.0.0.1:8080
WEBAPP_SERVER_BIND=127.0.0.1:8081

# Set False and leave BOT_TOKEN empty for email-only operation.
TELEGRAM_ENABLED=True
BOT_TOKEN=your_bot_token_here
# TELEGRAM_BOT_PROXY_URL=socks5://username:password@proxy.example.com:1080
# TELEGRAM_BOT_API_BASE_URL=http://telegram-bot-api:8081
TELEGRAM_OAUTH_USE_BOT_PROXY=True
ADMIN_IDS=123456789
POSTGRES_USER=remnawave_minishop
POSTGRES_PASSWORD=change_me_to_a_long_random_password
POSTGRES_DB=remnawave_minishop

WEBAPP_SESSION_SECRET=change_me_to_64_hex_chars
EMAIL_AUTH_SECRET=change_me_to_a_different_64_hex_secret
EMAIL_LOGIN_ENABLED=True
PUBLIC_APP_URL=https://app.example.com/
# Configure SMTP before using email-only mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_EMAIL=
WEBHOOK_SECRET_TOKEN=change_me_to_64_hex_chars
MINISHOP_EDGE_TOKEN=change_me_same_value_as_frontend
MINISHOP_EDGE_TOKEN_HEADER=X-Minishop-Edge-Token

# Optional server status section. Select one provider: url, uptime-kuma, or xray-checker.
SERVER_STATUS_ENABLED=False
SERVER_STATUS_PROVIDER=url
SERVER_STATUS_URL=
SERVER_STATUS_KUMA_URL=
SERVER_STATUS_XRAY_CHECKER_URL=
SERVER_STATUS_CACHE_TTL_SECONDS=30
SERVER_STATUS_STALE_TTL_SECONDS=300
SERVER_STATUS_TIMEOUT_SECONDS=5

PANEL_API_URL=https://panel.example.com/api
PANEL_API_KEY=change_me
PANEL_WEBHOOK_SECRET=change_me
