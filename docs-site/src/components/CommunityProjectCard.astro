---
import { Icon } from '@astrojs/starlight/components';
import { repositoryStars, starsVerifiedAt, type CommunityProject } from '../data/awesomeMinishop';

interface Props {
  project: CommunityProject;
  eager?: boolean;
  wide?: boolean;
}

const { project, eager = false, wide = false } = Astro.props;
const repositoryPath = new URL(project.repository).pathname.split('/').filter(Boolean).slice(0, 2).join('/');
const repositoryRoot = new URL(`/${repositoryPath}`, project.repository).href;
const stars = repositoryStars[repositoryPath];
const starsApi = project.forge === 'GitHub'
  ? `https://api.github.com/repos/${repositoryPath}`
  : `https://gitlab.com/api/v4/projects/${encodeURIComponent(repositoryPath)}`;
const forgeIcon = project.forge === 'GitHub' ? 'github' : 'gitlab';
---

<article class:list={['community-card', { 'community-card-wide': wide }]} id={project.id} aria-labelledby={`${project.id}-title`}>
  <a
    class="community-preview"
    href={project.preview}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`Открыть превью ${project.name} в новой вкладке`}
  >
    <img
      src={project.preview}
      alt={project.previewAlt}
      width="1200"
      height="750"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </a>
  <div class="community-card-body">
    <div class="community-card-heading">
      <h3 id={`${project.id}-title`}><a href={project.repository} target="_blank" rel="noopener noreferrer">{project.name}</a></h3>
      <a
        class="community-stars"
        href={repositoryRoot}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Звёзды на ${project.forge}: ${stars ?? 'количество неизвестно'}`}
        title={`Звёзды на ${project.forge}; данные на ${starsVerifiedAt}`}
        data-stars-api={starsApi}
        data-stars-field={project.forge === 'GitHub' ? 'stargazers_count' : 'star_count'}
        data-stars-status="snapshot"
        data-forge={project.forge}
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 3 2.8 5.7 6.3.9-4.6 4.4 1.1 6.3-5.6-3-5.6 3 1.1-6.3L2.9 9.6l6.3-.9L12 3Z" /></svg>
        <span data-star-count>{stars ?? '—'}</span>
      </a>
    </div>
    <a class="community-author" href={project.authorUrl} target="_blank" rel="noopener noreferrer">@{project.author}</a>
    <p class="community-description">{project.description}</p>
    <ul class="community-tags" aria-label={`Особенности ${project.name}`}>
      {project.tags.map((tag) => <li>{tag}</li>)}
    </ul>
    <div class="community-actions">
      <button class="community-details-button" type="button" data-project-dialog={`${project.id}-dialog`} aria-haspopup="dialog" aria-controls={`${project.id}-dialog`}>
        Подробнее{project.install ? ' и установка' : ''} <span aria-hidden="true">+</span>
      </button>
      <a class="community-repository" href={project.repository} target="_blank" rel="noopener noreferrer">
        <Icon name={forgeIcon} size="1rem" /><span>{project.forge}</span>
      </a>
    </div>
  </div>
  <dialog class="community-dialog" id={`${project.id}-dialog`} aria-labelledby={`${project.id}-dialog-title`} aria-describedby={`${project.id}-dialog-description`}>
    <div class="community-dialog-body">
      <div class="community-dialog-heading">
        <h2 id={`${project.id}-dialog-title`}>{project.name}</h2>
        <button type="button" class="community-dialog-close" data-close-project aria-label={`Закрыть сведения о ${project.name}`} autofocus>×</button>
      </div>
      <p class="community-dialog-author">Автор: <a href={project.authorUrl} target="_blank" rel="noopener noreferrer">@{project.author}</a></p>
      <p id={`${project.id}-dialog-description`} class="community-description">{project.description}</p>
      <ul class="community-features">{project.details.map((detail) => <li>{detail}</li>)}</ul>
      {project.install && (
        <div class="community-install">
          <p>В админке откройте <strong>Внешний вид → Добавить темы</strong> и укажите Git-репозиторий:</p>
          <a href={project.install.repository} target="_blank" rel="noopener noreferrer">{project.install.repository}</a>
          <dl>
            <div><dt>Ветка</dt><dd><code>{project.install.branch}</code></dd></div>
            {project.install.directory && <div><dt>Подпапка</dt><dd><code>{project.install.directory}</code></dd></div>}
          </dl>
          <a href="/features/theme-packages/">Инструкция по установке тем →</a>
        </div>
      )}
      <a class="community-repository community-dialog-repository" href={project.repository} target="_blank" rel="noopener noreferrer">
        <Icon name={forgeIcon} size="1rem" /><span>{project.forge}</span><span aria-hidden="true">↗︎</span>
      </a>
    </div>
  </dialog>
</article>

<style>
  .community-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 1rem;
    background: var(--sl-color-bg);
    scroll-margin-top: 6rem;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }
  .community-card:hover, .community-card:focus-within {
    border-color: var(--awesome-accent);
    box-shadow: 0 8px 30px var(--awesome-soft);
  }
  .community-preview {
    display: block;
    overflow: hidden;
    aspect-ratio: 8 / 5;
    background: #080d17;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }
  .community-preview img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 220ms ease;
  }
  .community-preview:hover img { transform: scale(1.025); }
  .community-card-body { display: flex; flex: 1; flex-direction: column; gap: 1rem; padding: 1.25rem; }
  .community-card-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem 0.75rem; }
  .community-card h3 { margin: 0; font-size: 1.2rem; line-height: 1.4; letter-spacing: -0.025em; }
  .community-card h3 a { color: var(--sl-color-white); text-decoration: none; }
  .community-author { width: fit-content; margin-top: -0.6rem; color: var(--sl-color-gray-2); font-size: 0.8rem; text-decoration: none; overflow-wrap: anywhere; }
  .community-stars { display: inline-flex; flex-shrink: 0; align-items: center; gap: 0.35rem; padding: 0.2rem 0.45rem; border: 1px solid var(--sl-color-gray-5); border-radius: 0.4rem; color: var(--sl-color-gray-2); font-size: 0.75rem; line-height: 1.4; text-decoration: none; }
  .community-stars svg { color: #d8a62d; }
  .community-stars:hover { border-color: var(--awesome-accent); }
  .community-description { flex: 1; margin: 0; color: var(--sl-color-gray-2); font-size: 0.9rem; line-height: 1.7; }
  .community-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0; padding: 0; list-style: none; }
  .community-tags li { margin: 0; border: 1px solid var(--sl-color-gray-5); border-radius: 0.4rem; padding: 0.2rem 0.5rem; color: var(--sl-color-gray-2); font-size: 0.7rem; }
  .community-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; border-top: 1px solid var(--sl-color-gray-5); padding-top: 1rem; }
  .community-details-button { display: inline-flex; flex: 1 1 11rem; align-items: center; justify-content: center; gap: 0.6rem; min-height: 2.6rem; border: 1px solid var(--sl-color-gray-5); border-radius: 0.6rem; padding: 0.55rem 0.8rem; background: transparent; color: var(--sl-color-white); font: inherit; font-size: 0.8rem; font-weight: 600; line-height: 1.4; white-space: nowrap; cursor: pointer; }
  .community-details-button:hover { border-color: var(--awesome-accent); background: var(--awesome-soft); color: var(--awesome-accent); }
  .community-install { border-top: 1px solid var(--sl-color-gray-5); padding-top: 0.75rem; overflow-wrap: anywhere; }
  .community-install p { margin: 0 0 0.6rem; }
  .community-install a { color: var(--awesome-accent); }
  .community-install dl { display: grid; gap: 0.4rem; margin: 0.75rem 0; }
  .community-install dl div { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .community-install dt { min-width: 4.5rem; }
  .community-install dd { margin: 0; }
  .community-repository { display: flex; justify-content: center; align-items: center; min-height: 2.6rem; gap: 0.55rem; border: 1px solid var(--sl-color-gray-5); border-radius: 0.6rem; padding: 0.55rem 0.8rem; color: var(--sl-color-white); font-size: 0.8rem; font-weight: 600; text-decoration: none; }
  .community-repository:hover { border-color: var(--awesome-accent); background: var(--awesome-soft); color: var(--awesome-accent); }
  a:focus-visible, button:focus-visible { outline: 2px solid var(--awesome-accent); outline-offset: 4px; border-radius: 0.3rem; }
  .community-dialog { box-sizing: border-box; width: min(42rem, calc(100vw - 2rem)); max-height: calc(100dvh - 3rem); margin: auto; overflow-y: auto; border: 1px solid var(--sl-color-gray-5); border-radius: 1rem; padding: 0; background: var(--sl-color-bg); color: var(--sl-color-white); box-shadow: 0 24px 90px #0005; }
  .community-dialog::backdrop { background: rgb(5 8 15 / 65%); backdrop-filter: blur(6px); }
  .community-dialog-body { padding: clamp(1.25rem, 4vw, 2rem); }
  .community-dialog-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .community-dialog h2 { margin: 0; font-size: 1.5rem; line-height: 1.4; }
  .community-dialog-close { display: grid; flex: 0 0 auto; width: 2.25rem; height: 2.25rem; place-items: center; border: 1px solid var(--sl-color-gray-5); border-radius: 0.5rem; background: transparent; color: var(--sl-color-gray-2); font: inherit; font-size: 1.4rem; line-height: 1; cursor: pointer; }
  .community-dialog-close:hover { background: var(--sl-color-gray-6); color: var(--sl-color-white); }
  .community-dialog-author { margin: 0.5rem 0 1.25rem; color: var(--sl-color-gray-2); font-size: 0.8rem; }
  .community-dialog-author a { color: var(--awesome-accent); }
  .community-features { margin: 1.25rem 0; padding-left: 1.25rem; color: var(--sl-color-gray-2); font-size: 0.9rem; line-height: 1.7; }
  .community-features li + li { margin-top: 0.5rem; }
  .community-install { font-size: 0.9rem; line-height: 1.7; }
  .community-dialog-repository { margin-top: 1.5rem; }
  :global(html:has(.awesome-catalog)) { scrollbar-gutter: stable; }
  :global(html:has(.community-dialog[open])) { overflow: hidden; }
  @media (min-width: 48rem) {
    .community-card-wide { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .community-card-wide .community-preview { height: 100%; min-height: 16rem; aspect-ratio: auto; border-bottom: 0; border-right: 1px solid var(--sl-color-gray-5); }
  }
  @media (prefers-reduced-motion: reduce) { .community-card, .community-preview img { transition: none; } .community-preview:hover img { transform: none; } }
</style>
