---
import type { StarlightRouteData } from '@astrojs/starlight/route-data'
import { Icon } from '@astrojs/starlight/components'
import LanguageSelect from 'virtual:starlight/components/LanguageSelect'
import Search from 'virtual:starlight/components/Search'
import SiteTitle from 'virtual:starlight/components/SiteTitle'
import SocialIcons from 'virtual:starlight/components/SocialIcons'
import ThemeSelect from 'virtual:starlight/components/ThemeSelect'
import config from 'virtual:starlight/user-config'

import MobileMenuToggle from 'starlight-theme-nova/components/MobileMenuToggle.astro'
import options from 'virtual:starlight-theme-nova/user-config'

const { hasSidebar } = Astro.locals.starlightRoute
const nav = options.nav ?? []
const route = Astro.locals.starlightRoute

function getI18nText(
  value: string | Record<string, string>,
  route: StarlightRouteData,
): string {
  if (typeof value === 'string') {
    return value
  }

  const { lang, locale } = route

  if (value[lang]) {
    return value[lang]
  }

  if (config.defaultLocale.lang === lang || config.defaultLocale.locale === locale) {
    if (value.root) {
      return value.root
    }
  }

  if (locale && value[locale]) {
    return value[locale]
  }

  throw new Error(`Unable to find the translation for language "${lang}".`)
}

function navIcon(href: string) {
  if (href.includes('github.com/3252a8/remnawave-minishop')) {
    return 'github'
  }
  if (href.includes('gitlab.com/3252a8/remnawave-minishop')) {
    return 'gitlab'
  }
  if (href.includes('t.me/remnawave_minishop')) {
    return 'telegram'
  }
  return undefined
}

function isProLink(href: string) {
  return href.startsWith('https://cloud.minidoc.cc')
}

function isDocsVersionLink(href: string) {
  return (
    href === 'https://minishop.minidoc.cc' ||
    href === 'https://dev.minishop.minidoc.cc'
  )
}

const navItems = nav.map((item) => {
  const href = getI18nText(item.href, route)
  return {
    href,
    label: getI18nText(item.label, route),
    icon: navIcon(href),
    pro: isProLink(href),
    docsVersion: isDocsVersionLink(href),
  }
})
// Text links first and the PRO pill last, community links as icon buttons next to the
// search, and the stable/dev switch as a compact link on the right.
const textNavItems = [
  ...navItems.filter((item) => !item.icon && !item.pro && !item.docsVersion),
  ...navItems.filter((item) => item.pro),
]
const iconNavItems = navItems.filter((item) => item.icon)
const docsVersionItem = navItems.find((item) => item.docsVersion)

---

<div class="box-border flex h-full items-center gap-2">
  <div
    class:list={[
      '-m-3 overflow-clip p-3',
      'flex min-w-0',
    ]}
  >
    <SiteTitle />
  </div>
  <nav
    class="minishop-desktop-nav hidden flex-1 flex-row gap-1 overflow-x-auto py-3 pr-2 pl-3 text-sm font-medium md:flex xl:pl-5"
  >
    {
      textNavItems.map((item) => (
        <a
          class:list={[
            'minishop-nav-item no-underline focus-visible:outline-offset-0',
            item.pro && 'minishop-header-link minishop-pro-link',
          ]}
          href={item.href}
        >
          {item.pro && (
            <svg class="minishop-pro-diamond" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3.5 9 8 3.75h8L20.5 9 12 20.25 3.5 9Z" />
              <path d="m8 3.75 4 5.25 4-5.25M3.5 9h17M8.25 9 12 20.25 15.75 9" />
            </svg>
          )}
          <span>{item.label}</span>
        </a>
      ))
    }
  </nav>
  {
    (docsVersionItem || iconNavItems.length > 0) && (
      <div class="minishop-header-links hidden items-center md:flex print:hidden">
        {docsVersionItem && (
          <a class="minishop-version-link" href={docsVersionItem.href}>
            {docsVersionItem.label}
          </a>
        )}
        {iconNavItems.map((item) => (
          <a
            class="minishop-icon-link"
            href={item.href}
            aria-label={item.label}
            title={item.label}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name={item.icon!} size="1.05rem" color="currentColor" />
          </a>
        ))}
      </div>
    )
  }
  <div class="minishop-header-search ml-auto flex md:max-w-60 md:flex-1 print:hidden">
    <Search />
  </div>
  {
    !hasSidebar && nav.length > 0 && (
      <details class="minishop-mobile-nav md:hidden print:hidden">
        <summary aria-label="Menu">
          <span aria-hidden="true" />
        </summary>
        <div class="minishop-mobile-nav-panel">
          {navItems.map((item) => (
            <a
              class:list={[
                'minishop-mobile-nav-link',
                (item.icon || item.pro) && 'minishop-header-link',
                item.pro && 'minishop-pro-link',
              ]}
              href={item.href}
            >
              {item.pro && (
                <svg class="minishop-pro-diamond" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M3.5 9 8 3.75h8L20.5 9 12 20.25 3.5 9Z" />
                  <path d="m8 3.75 4 5.25 4-5.25M3.5 9h17M8.25 9 12 20.25 15.75 9" />
                </svg>
              )}
              {item.icon && <Icon name={item.icon} size="1rem" color="currentColor" />}
              <span>{item.label}</span>
            </a>
          ))}
        </div>
      </details>
    )
  }
  <div class="hidden items-center gap-2 md:flex print:hidden">
    <SocialIcons />
    <LanguageSelect />
    <ThemeSelect />
  </div>
  {
    hasSidebar && (
      <div class="flex items-center gap-2 md:hidden print:hidden">
        <MobileMenuToggle />
      </div>
    )
  }
</div>

<style>
  .minishop-desktop-nav {
    min-width: 0;
    align-items: center;
    scrollbar-width: none;
  }

  .minishop-desktop-nav::-webkit-scrollbar {
    display: none;
  }

  .minishop-nav-item {
    display: inline-flex;
    flex: 0 0 auto;
    height: 2rem;
    align-items: center;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 0 0.625rem;
    color: var(--sl-color-gray-3);
    white-space: nowrap;
  }

  .minishop-nav-item:hover {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
  }

  .minishop-nav-item.minishop-pro-link {
    margin-left: 0.375rem;
  }

  .minishop-header-links {
    flex: 0 0 auto;
    gap: 0.125rem;
  }

  .minishop-version-link {
    display: inline-flex;
    height: 2rem;
    align-items: center;
    margin-right: 0.375rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    padding: 0 0.625rem;
    color: var(--sl-color-gray-3);
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .minishop-icon-link {
    display: inline-grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 8px;
    color: var(--sl-color-gray-3);
  }

  .minishop-version-link:hover,
  .minishop-icon-link:hover {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
  }

  @media (min-width: 48rem) and (max-width: 90rem) {
    .minishop-desktop-nav {
      font-size: 0.8125rem;
    }

    .minishop-nav-item {
      padding: 0 0.5rem;
    }

    .minishop-header-search {
      flex: 0 0 auto;
      width: 2rem;
    }

    .minishop-header-search :global(site-search) {
      display: block;
      width: 2rem;
    }

    /* Same 32px square as the theme toggle and the community icon links. */
    .minishop-header-search :global(button[data-open-modal]) {
      width: 2rem;
      height: 2rem;
      border-color: transparent;
      padding: 0.5rem;
    }

    .minishop-header-search :global(button[data-open-modal] > :is(span, kbd)) {
      display: none !important;
    }
  }

  @media (min-width: 48rem) and (max-width: 64rem) {
    .minishop-version-link {
      display: none;
    }
  }
</style>
